# Строка подключения Postgres
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Секрет подписи документов, не короче 32 символов. Менять и терять нельзя.
SIGNING_SECRET=

# Постоянный адрес сайта: попадает в QR-коды документов
PUBLIC_URL=https://check.example.com

# Размер пула соединений (необязательно)
DB_POOL_MAX=3
